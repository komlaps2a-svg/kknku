<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <rect width="512" height="512" rx="112" fill="#0f172a"/>
  <!-- Decorative Document Outline -->
  <path d="M140 160 a20 20 0 0120-20 h200 a20 20 0 0120 20 v200 a20 20 0 01-20 20 h-200 a20 20 0 01-20-20 z" fill="none" stroke="#3b82f6" stroke-width="32" stroke-linecap="round" stroke-linejoin="round" />
  <!-- Text/Lines representation -->
  <path d="M200 240 h120 M200 320 h120 M200 160 h50" stroke="#f8fafc" stroke-width="36" stroke-linecap="round"/>
  <!-- Checkmark signifying "Pro" or "Done" -->
  <path d="M280 400 l40 40 l80 -80" fill="none" stroke="#10b981" stroke-width="40" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
